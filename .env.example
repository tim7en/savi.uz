# Copy to .env and fill in. .env is gitignored; never commit real keys.

# Free key: https://fredaccount.stlouisfed.org/apikeys
# Required for macro history -- without it FRED serves only the latest revision,
# with no vintages and no release dates.
FRED_API_KEY=

# Free key: https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# data.sec.gov rejects default library user agents and asks that yours identify
# you. Optional -- there is a working default -- but set it to be a good citizen.
SEC_USER_AGENT=savi-uz-research/1.0 (you@example.com)

# Free key: https://www.tiingo.com/account/api/token
# Needed for intraday bars. The free tier allows 50 requests/hour, 1000/day and
# 500 unique symbols/month; the downloader paces below that by default.
TIINGO_API_KEY=

# Bearer token: https://www.marketdata.app/dashboard/
# Used for historical end-of-day option chains and locally calculated GEX.
MARKETDATA_TOKEN=
# Optional second account/key; select it with --token-env MARKETDATA_TOKEN2.
MARKETDATA_TOKEN2=
