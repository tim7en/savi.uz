# Copy to .env and fill in. .env is gitignored; never commit real keys.

# Free key: https://fredaccount.stlouisfed.org/apikeys
# Required for macro history -- without it FRED serves only the latest revision,
# with no vintages and no release dates.
FRED_API_KEY=

# Free key: https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=
